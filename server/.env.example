# Copy this file to .env for local development.

PORT=8080

# Neon direct (unpooled) connection string. The Go server keeps its own
# connection pool, so it does not need Neon's pooler.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# The Next.js app signs the JWT. Go verifies it with these public keys.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# Comma separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
